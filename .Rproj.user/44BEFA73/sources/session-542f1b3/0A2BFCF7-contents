# https://mrdata.usgs.gov/major-deposits/package.php 
zambia <- read_sf("usgszambia")

# from simplemaps
zambia_district <- st_read(dsn = "districts", layer = "zm")

ggplot() +
  labs(x="Longitude (WGS84)", y="Latitude",
       title="Zambia mineral map") + 
  geom_sf(data=zambia, col="blue", lwd=0.4, pch=21) +
  theme_bw()

boundary <- read_sf("zmb_shp")

# create plot of zambia mines over the country map 
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Zambia") + 
  geom_sf(data=zambia, aes(x=longitude, y=latitude, color = dep_type))
  coord_sf()
  

# create plot of zambia at the district (province level)
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Zambia") + 
  geom_sf(data=zambia_district)

coord_sf()

# add in stats from labour survey at district level 
employment_ag_nonag_regional <- read_csv("employment-ag-nonag-regional.csv")
district_level <- merge(zambia_district, employment_ag_nonag_regional, by="name")

# ag employment (count)
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Agriculture Employment by Province") + 
  scale_fill_gradient(low = "forestgreen", high = "red", 
                      labels = scales::comma) +
  labs(fill = "Count of Employed") +
  geom_sf(data=district_level, aes(fill = ag_employed_count)) + 
  theme_void()

# ag employment (percentage)
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Agriculture Employment by Province") + 
  scale_fill_gradient(low = "forestgreen", high = "red", 
                      labels = function(x) paste0(scales::comma(x), "%")) +
  labs(fill = "Share of region") +
  geom_sf(data=district_level, aes(fill = ag_employed_per)) + 
  theme_void()

# nonag employment (count)
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Non-agriculture Employment by Province") + 
  scale_fill_gradient(low = "tan", high = "brown", 
                      labels = scales::comma) +
  labs(fill = "Count of Employed") +
  geom_sf(data=district_level, aes(fill = non_ag_employed_count)) + 
  theme_void()

# nonag employment (percentage)
ggplot() + 
  geom_sf(data = boundary, size = 1.5, color = "black") + 
  ggtitle("Non-agriculture Employment by Province") + 
  scale_fill_gradient(low = "tan", high = "brown", 
                      labels = function(x) paste0(scales::comma(x), "%")) +
  labs(fill = "Share of region") +
  geom_sf(data=district_level, aes(fill = non_ag_employed_per)) + 
  theme_void()


